# PostgreSQL connection string (must point at a database with the PostGIS extension available)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wastedetection

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:3000

# Where uploaded images are written on local disk (relative to backend/ or absolute in prod)
UPLOAD_DIR=uploads

# Public URL this backend is reachable at, used to build image_url values returned to clients
PUBLIC_BASE_URL=http://localhost:8000
